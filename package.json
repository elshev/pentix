{
  "name": "pentix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#pentix/core": "./packages/pentix-core/dist/index.js"
  },
  "scripts": {
    "clean:core": "node -e \"require('node:fs').rmSync('packages/pentix-core/dist', { recursive: true, force: true })\"",
    "clean:server": "node -e \"require('node:fs').rmSync('apps/pentix-server/dist', { recursive: true, force: true })\"",
    "clean:dist": "npm run clean:core && npm run clean:server",
    "dev:web": "vite --config apps/pentix-web/vite.config.ts",
    "build:web": "tsc -p apps/pentix-web/tsconfig.json && vite build --config apps/pentix-web/vite.config.ts",
    "preview:web": "vite preview --config apps/pentix-web/vite.config.ts",
    "build:core": "npm run clean:core && tsc -p packages/pentix-core/tsconfig.json",
    "build:server": "npm run clean:server && tsc -p apps/pentix-server/tsconfig.json",
    "start:server": "npm run build:core && npm run build:server && node apps/pentix-server/dist/main.js",
    "build": "npm run build:core && npm run build:server && npm run build:web",
    "test": "npm run build:core && npm run build:server && node --test tests/pentix-core.test.mjs tests/pentix-server.test.mjs && node --experimental-strip-types --no-warnings --test tests/pentix-web.test.mjs",
    "test:web": "npm run build:core && node --experimental-strip-types --no-warnings --test tests/pentix-web.test.mjs",
    "lint": "eslint .",
    "preview": "npm run preview:web"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swagger-ui-dist": "^5.36.0",
    "uuid": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
