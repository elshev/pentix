{
  "name": "pentix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --config apps/pentix-web/vite.config.ts",
    "build:web": "tsc -p apps/pentix-web/tsconfig.json && vite build --config apps/pentix-web/vite.config.ts",
    "preview:web": "vite preview --config apps/pentix-web/vite.config.ts",
    "build:core": "tsc -p packages/pentix-core/tsconfig.json",
    "build:server": "tsc -p apps/pentix-server/tsconfig.json",
    "start:server": "npm run build:core && npm run build:server && node apps/pentix-server/dist/main.js",
    "build": "npm run build:core && npm run build:server && npm run build:web",
    "test": "npm run build:core && npm run build:server && node --test tests/pentix-core.test.mjs tests/pentix-server.test.mjs",
    "lint": "eslint .",
    "preview": "npm run preview:web"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
